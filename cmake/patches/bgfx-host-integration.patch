+	// ------------------------------------------------------------------------
+	// Bismuth patch: embedding bgfx inside an application that already renders
+	// with its own OpenGL context (Geometry Dash / cocos2d-x).
+	// All functions must be called from the render thread (single-threaded mode).
+	// ------------------------------------------------------------------------
+
+	/// OpenGL/OpenGL ES: switch to host mode. bgfx renders views targeting the
+	/// back buffer into framebuffer object `_fbo` and never presents/swaps.
+	/// Call before `init` and whenever the host's framebuffer binding changes.
+	void glSetHostFramebuffer(uint32_t _fbo);
+
+	/// Vulkan: native objects owned by bgfx (VkInstance, VkPhysicalDevice, ...).
+	struct VkHostInterop
+	{
+		void*    instance;
+		void*    physicalDevice;
+		void*    device;
+		void*    queue;
+		uint32_t queueFamilyIndex;
+		void*    getInstanceProcAddr; ///< PFN_vkGetInstanceProcAddr
+		void*    getDeviceProcAddr;   ///< PFN_vkGetDeviceProcAddr
+	};
+
+	/// Vulkan: hooks used when bgfx creates the image of a marked texture.
+	struct VkExternalTextureHooks
+	{
+		void*       userData;
+		const void* imageCreatePNext; ///< Chained into VkImageCreateInfo::pNext.
+
+		/// Allocates and binds memory for `_image` (VkImage). Writes VkDeviceMemory
+		/// to `_outMemory`; bgfx frees it with the texture. Returns VkResult.
+		int32_t (*allocateAndBind)(void* _userData, void* _device, uint64_t _image, void* _outMemory);
+	};
+
+	/// Vulkan: prefer the physical device with this VkPhysicalDeviceIDProperties::deviceUUID
+	/// (16 bytes, NULL to clear). `init` fails if no device matches. Call before `init`.
+	void vkSetPreferredDeviceUuid(const uint8_t* _uuid);
+
+	/// Vulkan: mark texture `_handle` as shared. Must be called after `createTexture*`
+	/// and before the frame that creates it. NULL hooks unmark. Shared textures are
+	/// transitioned to VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL at the end of each frame.
+	void vkSetExternalTexture(TextureHandle _handle, const VkExternalTextureHooks* _hooks);
+
+	/// Vulkan: semaphores (VkSemaphore) to wait on / signal with the next frame's
+	/// final queue submission. Returns false if too many.
+	bool vkSetFrameSemaphores(const uint64_t* _wait, uint32_t _numWait, const uint64_t* _signal, uint32_t _numSignal);
+
+	/// Vulkan: returns false if the Vulkan renderer isn't active.
+	bool vkGetHostInterop(VkHostInterop* _out);
+
+	/// Metal: block until the last frame's command buffer is scheduled (or completed).
+	void mtlWaitForLastFrame(bool _completed);
+
+	/// Reset all host-integration state. Call after `shutdown`.
+	void clearHostIntegration();
+
